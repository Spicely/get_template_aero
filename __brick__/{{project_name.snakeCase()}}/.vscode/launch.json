{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "{{project_name}} ({{flavor_name}})",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "{{flavor_name}}"
            ]
        },
        {
            "name": "{{project_name}} ({{flavor_name}}) [release]",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "args": [
                "--flavor",
                "{{flavor_name}}"
            ]
        }
    ]
}