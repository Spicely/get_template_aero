{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "{{project_name}} ({{project_name.snakeCase()}})",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "args": [
                "--flavor",
                "{{project_name.snakeCase()}}"
            ]
        },
        {
            "name": "{{project_name}} ({{project_name.snakeCase()}}) [release]",
            "request": "launch",
            "type": "dart",
            "program": "lib/main.dart",
            "flutterMode": "release",
            "args": [
                "--flavor",
                "{{project_name.snakeCase()}}"
            ]
        }
    ]
}