{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "flutter: build apk ({{project_name}}-release)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "build",
                "apk",
                "--release",
                "--flavor",
                "{{flavor_name}}"
            ],
            "group": "build"
        },
        {
            "label": "flutter: build appbundle ({{project_name}}-release)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "build",
                "appbundle",
                "--release",
                "--flavor",
                "{{flavor_name}}"
            ],
            "group": "build"
        },
        {
            "label": "flutter: build ipa ({{project_name}}-release)",
            "type": "shell",
            "command": "flutter",
            "args": [
                "build",
                "ipa",
                "--release"
            ],
            "group": "build"
        }
    ]
}